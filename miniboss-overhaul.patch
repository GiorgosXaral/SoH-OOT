new file mode 100644
index 0000000..b18a4c8
--- /dev/null
+++ b/soh/include/miniboss_overhaul.h
@@ -0,0 +1,39 @@
+#ifndef MINIBOSS_OVERHAUL_H
+#define MINIBOSS_OVERHAUL_H
+
+/**
+ * Miniboss Overhaul
+ *
+ * Shared helpers for the "Miniboss Overhaul" enhancement (Enhancements > Difficulty > Enemies), covering every
+ * repeated miniboss encounter in the game:
+ *
+ *  - Stalfos (the locked-room fight in the Forest Temple / Ganon's Castle Forest Trial - not the regular Ganon's
+ *    Castle hallway Stalfos, which stay vanilla).
+ *  - Flare Dancer (Fire Temple, x2).
+ *  - Dark Link (Water Temple).
+ *  - Dead Hand (Shadow Temple / Bottom of the Well).
+ *  - Iron Knuckle, including the possessed-Nabooru fight (Spirit Temple x2, Ganon's Castle Spirit Trial).
+ *
+ *  - Double Miniboss HP:     every miniboss above needs twice the damage to be defeated.
+ *  - Extra Miniboss Attacks: every miniboss above gets extra attacks, and fights more aggressively once it's badly
+ *                            hurt ("enraged").
+ *
+ * Both options are enabled by default and can be toggled independently from the menu, and independently from the
+ * main "Boss Overhaul" (Gohma through Ganon) options in boss_overhaul.h. Only vanilla actors, effects, sounds and
+ * models are used - nothing new is added.
+ */
+
+#include <libultraship/bridge/consolevariablebridge.h>
+#include "soh/cvar_prefixes.h"
+
+#define MO_HP_ENABLED() (CVarGetInteger(CVAR_ENHANCEMENT("MinibossOverhaul.DoubleHP"), 1) != 0)
+#define MO_ATTACKS_ENABLED() (CVarGetInteger(CVAR_ENHANCEMENT("MinibossOverhaul.ExtraAttacks"), 1) != 0)
+
+// Scales a miniboss health constant (the vanilla value is kept when Double Miniboss HP is disabled).
+#define MO_HP(vanilla) (MO_HP_ENABLED() ? ((vanilla) * 2) : (vanilla))
+
+// Convenience for "enraged" checks: true when `cur` is at or below half of the miniboss' (possibly doubled) max
+// health, so the threshold stays at the same proportion of the fight whether or not Double HP is on.
+#define MO_BELOW_HALF(cur, vanillaMax) ((cur) <= (MO_HP(vanillaMax) / 2))
+
+#endif
